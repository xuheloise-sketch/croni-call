{
  "mcpServers": {
    "ringback-voice": {
      "command": "${CLAUDE_PLUGIN_ROOT}/bin/run-voice-native.sh",
      "env": {
        "VOICE_SIP_ID": "${user_config.sip_id}",
        "VOICE_SIP_USER": "${user_config.sip_user}",
        "VOICE_SIP_PASS": "${user_config.sip_pass}",
        "VOICE_SIP_CALLEE": "${user_config.sip_callee}",
        "VOICE_DISPLAY_NAME": "${user_config.display_name}",
        "VOICE_STT_KEY": "${user_config.stt_api_key}",
        "VOICE_STT_URL": "${user_config.stt_url}",
        "VOICE_STT_MODEL": "${user_config.stt_model}",
        "VOICE_STT_LANG": "${user_config.stt_lang}",
        "VOICE_EDGE_VOICE": "${user_config.tts_voice}",
        "VOICE_STUN": "${user_config.stun_server}",
        "VOICE_END_SILENCE": "${user_config.end_silence}"
      }
    }
  }
}
