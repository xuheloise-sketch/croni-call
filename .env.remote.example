# Copy to ~/.config/croni-call/remote.env and chmod 600.
# Never commit the real file.

# AI-side Linphone account (caller)
VOICE_SIP_ID=sip:ai-account@sip.linphone.org
VOICE_SIP_USER=ai-account
VOICE_SIP_PASS=replace-with-sip-password
VOICE_SIP_PROXY=sip:sip.linphone.org;transport=tls
VOICE_DISPLAY_NAME=Croni

# Fixed phone-side Linphone account (callee). Public MCP tools cannot override it.
VOICE_SIP_CALLEE=sip:phone-account@sip.linphone.org

# Speech-to-text
VOICE_STT_KEY=replace-with-stt-key
VOICE_STT_LANG=zh

# Public MCP endpoint and bootstrap bearer authentication
CRONI_MCP_RESOURCE_URL=https://call.example.com/mcp
CRONI_AUTH_ISSUER_URL=https://call.example.com
CRONI_MCP_BEARER_TOKEN=replace-with-at-least-32-random-characters
CRONI_MCP_HOST=127.0.0.1
CRONI_MCP_PORT=8765
CRONI_ALLOWED_HOSTS=call.example.com
CRONI_ALLOWED_ORIGINS=https://call.example.com

# Safety policy
CRONI_TIMEZONE=Asia/Shanghai
CRONI_QUIET_START=23:00
CRONI_QUIET_END=08:00
CRONI_DAILY_CALL_LIMIT=3
CRONI_MINIMUM_RETRY_SECONDS=300
CRONI_MAXIMUM_CALL_SECONDS=900
CRONI_POLICY_STATE_FILE=~/.local/state/croni-call/policy.json
